+/* Integer position pos carrying over the sub-pixel part of cur (positions are read truncated towards zero) */
+static float Mouse_KeepSubPixel(Bit16s pos, float cur) {
+	float frac = static_cast<float>(fabs(cur - static_cast<float>(static_cast<Bit16s>(cur))));
+	return (pos >= 0) ? static_cast<float>(pos) + frac : static_cast<float>(pos) - frac;
+}
